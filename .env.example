# Local development needs none of these: no DATABASE_URL → embedded PGlite in .data/pglite,
# no UPLOADS_S3_URI → files in data/uploads, no BASE_PATH → AUTH_MODE=dev (open /team to sign in
# as "Local Dev"). Production values live in infra/prod.yaml and SSM /ambassador/*.

# ── Server ─────────────────────────────────────────────────────
PORT=3001
# Path prefix behind admin.lovepop.com. When set (or NODE_ENV=production) the server refuses to
# start unless every SSO setting and both session secrets below are set.
BASE_PATH=
APP_URL=

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=

# ── Uploads ─────────────────────────────────────────────────────
UPLOADS_S3_URI=
UPLOADS_DIR=

# ── Auth ────────────────────────────────────────────────────────
# sso (conan-edogawa broker, team only) or dev (local only)
AUTH_MODE=
SSO_TICKET_SECRET=
SSO_TICKET_AUDIENCE=
SSO_AUTHORIZE_URL=
# Two different random strings, 32+ characters each
TEAM_SESSION_SECRET=
INFLUENCER_SESSION_SECRET=
